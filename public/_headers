# HQ product metrics envelope — short cache, CORS for hq.giveabit.io poll
/metrics.json
  Content-Type: application/json
  Cache-Control: public, max-age=60, must-revalidate
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS

# Short TTL — never immutable (prevents caching SPA HTML fallback as JS during deploys)
/assets/*
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

# Cache fonts for 1 year
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# HTML — no cache (always fresh)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Root index
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), interest-cohort=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# giveabit.io — Cloudflare Pages _headers
/assets/*.css
  Content-Type: text/css

/assets/*.js
  Content-Type: application/javascript

# Security headers for all pages — CSP lives here, site-wide. It must stay in
# this catch-all block, NOT the `/` block: a CSP scoped to `/` only protects the
# homepage and every other SPA route ships without one (verified 2026-09-13).
# Do not widen connect-src — one host, only for a live need. sign-in is
# intentionally out of this build (accounts are not available), so identitytoolkit
# must never be allowlisted here.
# [2026-09-16 t_7010056b] connect-src narrowed by one host: https://*.supabase.co.
# Nothing in the shipped bundle references supabase.co (0 hits in dist/assets/*.js
# after a full build); @supabase/supabase-js is imported only by src/lib/db/*, which
# runs in the node server — a browser CSP directive cannot affect it.
# [2026-09-17 t_2039b0e1] connect-src narrowed by one host: https://*.nostr.build.
# RULING (nova, product): REMOVE. Measured the same way as supabase — 0 hits in
# src/ and 0 in dist/assets/*.js after a full build (the only occurrence anywhere in
# dist/ was this file) — and nothing shipped or scheduled needs it: the campaign
# creative picker reads the file locally (BuyAds `handleImageUpload` ->
# FileReader.readAsDataURL; the data URL never leaves the page, it is preview-only
# state) and Nostr distribution is a text-only kind-1 note signed by the user's
# NIP-07 extension (src/services/nostrService.ts). docs/DISTRIBUTION-ROADMAP.md
# phases 1-5 plan no NIP-96/NIP-94 upload, and Phase 1 proof is a vendor-submitted
# URL/screenshot, not an in-app upload. Note only an upload *fetch* would need
# connect-src — RENDERING a nostr.build image already works under
# img-src 'self' data: blob: https:. Re-add the host (one line) the day an upload UI
# ships; the live need justifies it then, and report-uri would surface the blocked
# request until it does.
# Every remaining host is backed by shipped code: mempool.space (PriceTicker),
# api.satohash.io + the wss:// relays (BuyAds), analytics.giveabit.io (index.html
# loads https://analytics.giveabit.io/script.js).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), interest-cohort=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://mempool.space https://analytics.giveabit.io https://satohash.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://mempool.space https://api.satohash.io wss://relay.damus.io wss://nos.lol wss://relay.snort.social https://analytics.giveabit.io; frame-src 'self'; manifest-src 'self'; report-uri https://tadbuy.giveabit.io/api/csp-report

# Block access to sensitive files
/.env
  X-Robots-Tag: noindex
/.git/*
  X-Robots-Tag: noindex
/server.ts
  X-Robots-Tag: noindex
/scripts/*.ts
  X-Robots-Tag: noindex
