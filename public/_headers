# HQ product metrics envelope — short cache, CORS for hq.giveabit.io poll
/metrics.json
  Content-Type: application/json
  Cache-Control: public, max-age=60, must-revalidate
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS

# Short TTL — never immutable (prevents caching SPA HTML fallback as JS during deploys)
/assets/*
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

# Cache fonts for 1 year
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# HTML — no cache (always fresh)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Root index
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://analytics.giveabit.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.satohash.io https://mempool.space https://analytics.giveabit.io

# giveabit.io — Cloudflare Pages _headers
/assets/*.css
  Content-Type: text/css

/assets/*.js
  Content-Type: application/javascript
