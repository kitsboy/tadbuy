# Example environment configuration
# Copy this file to .env and fill in actual values

# Relay Configuration
RELAY_IMAGE_VERSION=latest
RELAY_LOG_LEVEL=info

# Domain Configuration
US_DOMAIN=us.tadbuy.io
JP_DOMAIN=jp.tadbuy.io
DE_DOMAIN=de.tadbuy.io
NL_DOMAIN=nl.tadbuy.io
PT_DOMAIN=pt.tadbuy.io
SG_DOMAIN=sg.tadbuy.io
SV_DOMAIN=sv.tadbuy.io
AR_DOMAIN=ar.tadbuy.io

# SSL/TLS Configuration
SSL_EMAIL=admin@tadbuy.io
SSL_STAGING=false

# Monitoring
METRICS_URL=http://localhost:9090/metrics
ALERT_WEBHOOK=https://alerts.tadbuy.io/webhook
ALERT_EMAIL=ops@tadbuy.io

# Backup
BACKUP_S3_BUCKET=tadbuy-nostr-backups
BACKUP_S3_REGION=us-west-1
BACKUP_ENCRYPTION_KEY=change-this-to-secure-key

# Database
DB_RETENTION_DAYS=30
DB_BACKUP_INTERVAL_HOURS=6

# Networking
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443
EXTERNAL_NETWORK=tadbuy-prod

# Logging
LOG_LEVEL=info
LOG_MAX_SIZE=100
LOG_MAX_FILES=5

# Security
BAN_THRESHOLD=10
BAN_DURATION_HOURS=1
SPAM_MAX_MESSAGES=100
SPAM_TIME_WINDOW_SECONDS=300

# Regional Settings
US_LOCALE=en_US
JP_LOCALE=ja_JP
DE_LOCALE=de_DE
NL_LOCALE=nl_NL
PT_LOCALE=pt_PT
SG_LOCALE=en_SG
SV_LOCALE=es_SV
AR_LOCALE=es_AR

# Compliance
GDPR_ENABLED=true
MAS_COMPLIANCE_ENABLED=false
ARGENTINA_CENSORSHIP_BYPASS=true
EL_SALVADOR_BITCOIN_LEGAL_TENDER=true